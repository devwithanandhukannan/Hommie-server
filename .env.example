NODE_ENV=development
PORT=4000
# MongoDB Atlas free (M0) connection string. Create a DB user with readWrite on "familyhub" only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/familyhub?retryWrites=true&w=majority
# Exact origin(s) of the web app, comma separated. Used for CORS-free same-site CSRF origin checks.
WEB_ORIGIN=http://localhost:3000
# Generate the next four with: npm run secrets -w apps/api
JWT_ACCESS_SECRET=
DOC_MASTER_KEY=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
TRUST_PROXY=1
DEFAULT_TIMEZONE=Asia/Kolkata
INTERNAL_CRON=true
GEMINI_API_KEY=
